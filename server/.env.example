PORT=3000
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=12h

# Local: SQLite (arquivo). Vercel: Postgres (Neon) — DATABASE_URL=postgres://...
# Na Vercel, POSTGRES_URL do Marketplace também vale.
DB_PATH=./data/barbearia.db
# DATABASE_URL=postgres://USER:PASS@HOST/db?sslmode=require

ADMIN_PASSWORD=admin123
# Gerado localmente por: npm --prefix server run seed
# Na Vercel, defina ADMIN_PASSWORD_HASH (ou ADMIN_PASSWORD) nas env vars do projeto.
# ADMIN_PASSWORD_HASH=$2a$10$...
